@page "/about"
@using Nullkooland.Client.Models.Theme
@using Nullkooland.Client.ViewModels.Pages
@inject AboutPageViewModel ViewModel

<style>
    .dependency-logo {
        height: 64px;
        width: 64px;
        overflow: visible;
    }
</style>

<PageTitle>@ViewModel.PageTitle</PageTitle>

<MudContainer Class="mt-6" MaxWidth="MaxWidth.ExtraLarge">
    <MudText Typo="Typo.h3">About me</MudText>
    <MudText Class="mt-4" Typo="Typo.body1">Ah terrific, you've found my lair. ∠( ᐛ 」∠ )＿</MudText>
    <MudText Class="mt-2" Typo="Typo.body1">汝觅得吾穴，甚好。</MudText>
    <MudText Class="mt-2" Typo="Typo.body1">I'm a tiger and moonbear, intertwined.</MudText>
    <MudText Class="mt-2" Typo="Typo.body1">我是一只老虎和月熊，交织在一起。</MudText>
    <MudText Class="mt-2" Typo="Typo.body1">I'm hanging around south-west China.</MudText>
    <MudText Class="mt-2" Typo="Typo.body1">我出没在华山之阳。</MudText>
    <MudText Class="mt-2" Typo="Typo.body1">I love roaming, but am learning to settle down.</MudText>
    <MudText Class="mt-2" Typo="Typo.body1">我爱灯儿晃，但也在学会安定。</MudText>
    <MudText Class="mt-2" Typo="Typo.body1">As a programmer, I mainly use C/C++ and Python, MLIR, maybe a liitle Rust 🦀. No, no disgusting Java-ish thingies.</MudText>
    <MudText Class="mt-2" Typo="Typo.body1">作为开发者，我主要使用 C/C++、Python、MLIR，也许一丢丢 Rust。才不想碰名字带 Java 的什么玩意儿。</MudText>
    <MudText Class="mt-2" Typo="Typo.body1">Feel free to befriend me, I could use some cuddling~</MudText>
    <MudText Class="mt-2" Typo="Typo.body1">欢迎来和我交朋友，说不定能够抱抱~</MudText>

    <MudImage 
        Class="my-4"
        Src="images/yunshan_nullko_on_the_road.png"
        Alt="云山和努克在路上"
        Fluid="true"
    />

    <MudText Class="mt-2" Typo="Typo.h6">Observation concluded. Society research 🌐 +8 </MudText>
    <MudText Class="mt-2" Typo="Typo.h6">观察完成。社会学点数 🌐 +8</MudText>

    <MudDivider Class="my-8"></MudDivider>

    <MudText Typo="Typo.h3">About the website</MudText>
    <div class="mt-4 d-flex flex-wrap align-center">
        <MudText Class="mr-1" Typo="Typo.h5">A JS-free-ooland powered by the almighty</MudText>
        <MudLink Class="ml-0 mr-auto d-flex align-end" Typo="Typo.h5"
                 Href="https://blazor.net">
            <b>Blazor WebAssembly</b>
            <MudIcon Icon="@CustomIcons.Blazor" Size="Size.Large" Color="Color.Secondary"></MudIcon>
        </MudLink>
    </div>
    <MudText Typo="Typo.caption" Color="Color.Tertiary">
        Well, not exactly JS-free, since it still uses some JS-based libraries. But hey, at least I don't need to write JS by myself, sweet!
        Okay, I am considering switch the whole blog to Rust WASM, maybe using Leptos? We shall find out~
    </MudText>

    <MudText Class="mt-6 mb-4" Typo="Typo.h4">Dependencies</MudText>
    <MudGrid>
        <MudItem xs="12" md="6" lg="3" xl="2">
            <MudCard Elevation="2" Style="height: 96px">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <svg class="dependency-logo rounded">
                            <image xlink:href="https://raw.github.com/MudBlazor/MudBlazor/master/content/MudBlazor.svg"
                                   width="100%" height="100%"/>
                        </svg>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudLink Typo="Typo.body1"
                                 Color="Color.Secondary"
                                 Href="https://github.com/Garderoben/MudBlazor">
                            <b>MudBlazor</b>
                        </MudLink>
                        <MudText Typo="Typo.body2">
                            Material Design components library.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6" lg="3" xl="2">
            <MudCard Elevation="2" Style="height: 96px">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <svg class="dependency-logo">
                            <image xlink:href="https://raw.github.com/xoofx/markdig/master/img/markdig.svg"
                                   width="100%" height="100%"/>
                        </svg>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudLink Typo="Typo.body1"
                                 Color="Color.Secondary"
                                 Href="https://github.com/xoofx/markdig">
                            <b>Markdig</b>
                        </MudLink>
                        <MudText Typo="Typo.body2">
                            Markdown parsing and rendering.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6" lg="3" xl="2">
            <MudCard Elevation="2" Style="height: 96px">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <div class="dependency-logo d-flex align-center">
                            <MathBlock Inline="true" MathText="\large\KaTeX"></MathBlock>
                        </div>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudLink Typo="Typo.body1"
                                 Color="Color.Secondary"
                                 Href="https://github.com/KaTeX/KaTeX">
                            <b>KaTeX</b>
                        </MudLink>
                        <MudText Typo="Typo.body2">
                            TeX math rendering.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6" lg="3" xl="2">
            <MudCard Elevation="2" Style="height: 96px">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <svg class="dependency-logo">
                            <image xlink:href="https://raw.github.com/PrismJS/prism/master/assets/logo.svg"
                                   width="100%" height="100%" filter="drop-shadow(0 0 0.15rem grey)"/>
                        </svg>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudLink Typo="Typo.body1"
                                 Color="Color.Secondary"
                                 Href="https://github.com/PrismJS/prism">
                            <b>Prism</b>
                        </MudLink>
                        <MudText Typo="Typo.body2">
                            Code syntax highlighting.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6" lg="3" xl="2">
            <MudCard Elevation="2" Style="height: 96px">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <div class="dependency-logo"
                             style="font-size: 36pt; 
                                    text-align: center;">
                            🔮
                        </div>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudLink Typo="Typo.body1"
                                 Color="Color.Secondary"
                                 Href="https://utteranc.es">
                            <b>Utterances</b>
                        </MudLink>
                        <MudText Typo="Typo.body2">
                            GitHub issues based comments widget.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6" lg="3" xl="2">
            <MudCard Elevation="2" Style="height: 96px">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <svg class="dependency-logo">
                            <image xlink:href="https://raw.github.com/AOMediaCodec/artwork/master/avif-logo-rgb.svg"
                                   width="100%" height="100%"/>
                        </svg>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudLink Typo="Typo.body1"
                                 Color="Color.Secondary"
                                 Href="https://github.com/AOMediaCodec/libavif">
                            <b>LibAVIF</b>
                        </MudLink>
                        <MudText Typo="Typo.body2">
                            AVIF images encoding.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
            </MudCard>
        </MudItem>
    </MudGrid>

</MudContainer>
<Footer/>