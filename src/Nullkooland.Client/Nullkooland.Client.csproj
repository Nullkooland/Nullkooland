<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<InvariantGlobalization>true</InvariantGlobalization>
		<BlazorEnableCompression>false</BlazorEnableCompression>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Markdig" Version="1.1.3" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.7" PrivateAssets="all" />
		<PackageReference Include="MudBlazor" Version="9.4.0" />
		<PackageReference Include="System.Net.Http.Json" Version="10.0.7" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nullkooland.Shared\Nullkooland.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="wwwroot\posts\**" CopyToPublishDirectory="Never" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Models\Components\" />
	</ItemGroup>

</Project>
